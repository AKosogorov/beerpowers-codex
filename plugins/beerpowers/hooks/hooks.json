{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "perl \"${PLUGIN_ROOT}/hooks/dispatch.pl\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& (Join-Path (Split-Path (Split-Path (Get-Command git.exe -CommandType Application)[0].Source)) 'usr/bin/perl.exe') (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/dispatch.pl'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "perl \"${PLUGIN_ROOT}/hooks/dispatch.pl\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& (Join-Path (Split-Path (Split-Path (Get-Command git.exe -CommandType Application)[0].Source)) 'usr/bin/perl.exe') (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/dispatch.pl'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "perl \"${PLUGIN_ROOT}/hooks/dispatch.pl\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& (Join-Path (Split-Path (Split-Path (Get-Command git.exe -CommandType Application)[0].Source)) 'usr/bin/perl.exe') (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/dispatch.pl'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "perl \"${PLUGIN_ROOT}/hooks/dispatch.pl\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& (Join-Path (Split-Path (Split-Path (Get-Command git.exe -CommandType Application)[0].Source)) 'usr/bin/perl.exe') (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/dispatch.pl'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|(?:functions\\.)?(?:apply_patch|exec(?:_command)?))$",
        "hooks": [
          {
            "type": "command",
            "command": "perl \"${PLUGIN_ROOT}/hooks/dispatch.pl\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& (Join-Path (Split-Path (Split-Path (Get-Command git.exe -CommandType Application)[0].Source)) 'usr/bin/perl.exe') (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/dispatch.pl'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "perl \"${PLUGIN_ROOT}/hooks/dispatch.pl\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& (Join-Path (Split-Path (Split-Path (Get-Command git.exe -CommandType Application)[0].Source)) 'usr/bin/perl.exe') (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/dispatch.pl'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "perl \"${PLUGIN_ROOT}/hooks/dispatch.pl\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& (Join-Path (Split-Path (Split-Path (Get-Command git.exe -CommandType Application)[0].Source)) 'usr/bin/perl.exe') (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/dispatch.pl'); exit (Get-Variable LASTEXITCODE -ValueOnly)\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
